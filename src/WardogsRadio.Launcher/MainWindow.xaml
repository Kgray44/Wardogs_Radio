<Window x:Class="WardogsRadio.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WARDOGS Radio" Width="430" Height="210" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Ink}" Loaded="Window_Loaded">
  <Border Background="{StaticResource Panel}" Margin="14" Padding="24" CornerRadius="5"><StackPanel>
    <TextBlock Text="WARDOGS RADIO" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Olive}"/>
    <TextBlock x:Name="Status" Text="Checking for updates…" FontSize="16" Margin="0,20,0,5"/>
    <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Olive}" Background="#303A35"/>
    <TextBlock x:Name="Version" Text="" Opacity=".65" Margin="0,12,0,0"/>
  </StackPanel></Border>
</Window>
