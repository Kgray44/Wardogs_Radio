<Window x:Class="WardogsRadio.App.IconPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Icon" Width="560" Height="560" MinWidth="480" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{StaticResource InkBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="CHOOSE ICON" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Choose a symbol for this radio control." Opacity=".65" Margin="0,4,0,18"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" MinHeight="36" ToolTip="Search icons by name"/>
      <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="Category_Changed"/>
    </Grid>
    <ListBox x:Name="IconList" Grid.Row="2" SelectionChanged="Icon_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><StackPanel Width="98" Height="94" HorizontalAlignment="Center">
        <Viewbox Width="32" Height="32" HorizontalAlignment="Center" Margin="0,8,0,4"><Path Data="{Binding Shape}" Fill="{StaticResource OliveBrush}" Width="24" Height="24" Stretch="Uniform"/></Viewbox>
        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" FontSize="11"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="3" Margin="0,14,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="SELECTED" Foreground="{StaticResource OliveBrush}" Margin="0,0,8,0"/><TextBlock x:Name="SelectedName" Text="Patrol"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="CANCEL" IsCancel="True"/><Button Content="USE ICON" Click="Choose_Click" Background="#33452E"/></StackPanel></DockPanel>
  </Grid>
</Window>
