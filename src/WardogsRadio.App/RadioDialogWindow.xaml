<Window x:Class="WardogsRadio.App.RadioDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WARDOGS Radio" Width="440" SizeToContent="Height" MinHeight="180"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource OliveBrush}"
          BorderThickness="1" CornerRadius="7" Padding="22">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <TextBlock Text="WARDOGS RADIO" Foreground="{StaticResource OliveBrush}" FontSize="10" FontWeight="Bold"/>
        <TextBlock x:Name="DialogHeading" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <TextBlock x:Name="DialogMessage" Grid.Row="1" TextWrapping="Wrap" Margin="0,14,0,18" MaxWidth="390"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ThirdButton" Content="UNDO CHANGES" Visibility="Collapsed" Click="Third_Click"/>
        <Button x:Name="CancelButton" Content="CANCEL" IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="AcceptButton" Content="OK" IsDefault="True" Click="Accept_Click" Background="#33452E"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
