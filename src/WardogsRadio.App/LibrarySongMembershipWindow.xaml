<Window x:Class="WardogsRadio.App.LibrarySongMembershipWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Song Stations" Width="540" Height="500" WindowStartupLocation="CenterOwner" Background="#101514" Foreground="#E5E9DF" FontFamily="Segoe UI">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="STATION ASSIGNMENTS" Foreground="#9FB672" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="SongNameText" Text="SONG" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="HintText" Text="Changing these assignments does not alter the song itself." Opacity=".68" TextWrapping="Wrap" Margin="0,5,0,18"/></StackPanel><ListBox x:Name="StationList" Grid.Row="1"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#34413C" BorderThickness="0,0,0,1" Padding="4,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsAssigned, Mode=TwoWay}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Opacity=".62" FontSize="11"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="CANCEL" IsCancel="True"/><Button Content="SAVE ASSIGNMENTS" Click="Save_Click" Background="#33452E"/></StackPanel></Grid>
</Window>
