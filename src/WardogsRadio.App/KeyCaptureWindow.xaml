<Window x:Class="WardogsRadio.App.KeyCaptureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Keyboard Binding" Width="420" Height="220" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource InkBrush}" Foreground="{StaticResource TextBrush}" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="KEYBOARD BINDING" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Press a key…" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel>
    <TextBlock Grid.Row="1" Text="Press the key you want to use while WARDOGS Radio is running. Esc cancels." Opacity=".7" TextWrapping="Wrap" VerticalAlignment="Center"/>
    <Button Grid.Row="2" Content="CANCEL" IsCancel="True" HorizontalAlignment="Right"/>
  </Grid>
</Window>
