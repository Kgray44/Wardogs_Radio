<Window x:Class="WardogsRadio.App.LibrarySourceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add Library Source" Width="620" Height="360" WindowStartupLocation="CenterOwner" Background="#101514" Foreground="#E5E9DF" FontFamily="Segoe UI">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="MUSIC LIBRARY" Foreground="#9FB672" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="Heading" Text="ADD SOURCE" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Explanation" Text="The library references the original media; it never copies or converts it." Opacity=".68" TextWrapping="Wrap" Margin="0,5,0,18"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="DISPLAY NAME" Foreground="#9FB672" FontSize="11" FontWeight="Bold"/><TextBox x:Name="NameBox" Height="40" Margin="0,6,0,16" VerticalContentAlignment="Center" Padding="8,2"/><TextBlock x:Name="SourceLabel" Text="LOCAL MEDIA FILE" Foreground="#9FB672" FontSize="11" FontWeight="Bold"/><DockPanel Margin="0,6,0,0"><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="BROWSE" Click="Browse_Click"/><TextBox x:Name="SourceBox" Height="40" Margin="0,0,8,0" VerticalContentAlignment="Center" Padding="8,2" TextChanged="SourceBox_TextChanged"/></DockPanel><TextBlock x:Name="ValidationText" Foreground="#E6B65A" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="CANCEL" IsCancel="True"/><Button Content="ADD SOURCE" Click="Add_Click" Background="#33452E"/></StackPanel>
  </Grid>
</Window>
