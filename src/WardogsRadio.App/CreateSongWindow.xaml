<Window x:Class="WardogsRadio.App.CreateSongWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Create New Song" Width="430" SizeToContent="Height" MinWidth="430" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource InkBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="CREATE NEW SONG" Foreground="{StaticResource OliveBrush}" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="PointText" Text="Split at 00:00" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="The original file or video stays untouched. WARDOGS saves two playback ranges in this station." TextWrapping="Wrap" Opacity=".7" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,15,0,0"><TextBlock Text="Name for the new song"/><TextBox x:Name="SongName" Margin="0,5,0,0" MaxLength="120"/><TextBlock Text="Which section gets this name?" Margin="0,15,0,6"/><RadioButton x:Name="AfterChoice" Content="After this point" IsChecked="True"/><RadioButton x:Name="BeforeChoice" Content="Before this point" Margin="0,6,0,0"/><TextBlock x:Name="ErrorText" Foreground="{StaticResource AmberBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="CANCEL" Click="Cancel_Click"/><Button Content="CREATE SONG" Click="Create_Click" Background="#33452E" Margin="8,0,0,0"/></StackPanel>
  </Grid>
</Window>
