<Window x:Class="WardogsRadio.App.AccentColorPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Accent Color" Width="640" Height="590" MinWidth="490" MinHeight="510" WindowStartupLocation="CenterOwner"
        Background="{StaticResource InkBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="STATION &amp; MACRO IDENTITY" Foreground="{StaticResource OliveBrush}" FontSize="11" FontWeight="Bold"/>
      <TextBlock Text="Choose an accent color" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/>
      <TextBlock Text="Pick a swatch or enter a custom six-digit color. The preview shows how the accent looks on a dark radio card." TextWrapping="Wrap" Opacity=".7" Margin="0,6,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="RADIO PALETTE" Foreground="{StaticResource OliveBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
        <WrapPanel x:Name="PalettePanel"/>
        <TextBlock Text="CUSTOM COLOR" Foreground="{StaticResource OliveBrush}" FontSize="11" FontWeight="Bold" Margin="0,18,0,5"/>
        <TextBox x:Name="HexBox" MaxLength="7" MinHeight="38" Width="160" HorizontalAlignment="Left" VerticalContentAlignment="Center" TextChanged="HexBox_TextChanged" ToolTip="Enter a color as #RRGGBB"/>
        <TextBlock x:Name="ValidationText" Text="Use #RRGGBB, for example #9FB672." Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,16,0,0">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="PreviewSwatch" Width="52" Height="52" CornerRadius="4" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="YOUR ACCENT" FontSize="11" Opacity=".65"/><TextBlock x:Name="PreviewHex" FontSize="17" FontWeight="SemiBold"/></StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="CANCEL" IsCancel="True"/>
      <Button x:Name="ApplyButton" Content="USE THIS COLOR" IsDefault="True" Click="Apply_Click" Background="#33452E"/>
    </StackPanel>
  </Grid>
</Window>
