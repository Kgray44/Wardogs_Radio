<Window x:Class="WardogsRadio.App.LibrarySourceTypeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add Library Source" Width="600" Height="350" WindowStartupLocation="CenterOwner" Background="#101514" Foreground="#E5E9DF" FontFamily="Segoe UI">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="MUSIC LIBRARY" Foreground="#9FB672" FontWeight="Bold" FontSize="11"/><TextBlock Text="ADD A SOURCE" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Choose the same source family you use for a station. The Library only offers sources with a reliable single-media timeline for reusable cues." Opacity=".68" TextWrapping="Wrap" Margin="0,5,0,18"/></StackPanel>
    <WrapPanel Grid.Row="1"><Button Tag="mpv" Click="Provider_Click" Width="240" MinHeight="104"><StackPanel><TextBlock Text="LOCAL MUSIC" FontWeight="Bold"/><TextBlock Text="A media file already on this PC" Opacity=".7" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Button><Button Tag="youtube" Click="Provider_Click" Width="240" MinHeight="104"><StackPanel><TextBlock Text="YOUTUBE" FontWeight="Bold"/><TextBlock Text="One visible, embeddable video" Opacity=".7" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Button></WrapPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCEL" IsCancel="True"/></StackPanel>
  </Grid>
</Window>
