<Window x:Class="WardogsRadio.App.LibrarySourceTypeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add Library Source" Width="740" Height="500" WindowStartupLocation="CenterOwner" Background="#101514" Foreground="#E5E9DF" FontFamily="Segoe UI">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="MUSIC LIBRARY" Foreground="#9FB672" FontWeight="Bold" FontSize="11"/><TextBlock Text="ADD A SOURCE" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Choose the same source family available when you create a station. Sources with a stable single-media timeline can also be split into reusable cues." Opacity=".68" TextWrapping="Wrap" Margin="0,5,0,18"/></StackPanel>
    <WrapPanel Grid.Row="1">
      <Button Tag="mpv-local" Click="Provider_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="LOCAL MUSIC" FontWeight="Bold"/><TextBlock Text="Files and playlists" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
      <Button Tag="mpv-link" Click="Provider_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="INTERNET RADIO" FontWeight="Bold"/><TextBlock Text="Direct stream link" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
      <Button Tag="youtube" Click="Provider_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="YOUTUBE" FontWeight="Bold"/><TextBlock Text="Visible video player" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
      <Button Tag="external-audio" Click="Provider_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="MUSIC APP" FontWeight="Bold"/><TextBlock Text="Windows media session" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
      <Button Tag="soundcloud" Click="Provider_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="SOUNDCLOUD" FontWeight="Bold"/><TextBlock Text="Account access needed" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
      <Button Tag="applemusic" Click="Provider_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="APPLE MUSIC" FontWeight="Bold"/><TextBlock Text="Account access needed" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
    </WrapPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCEL" IsCancel="True"/></StackPanel>
  </Grid>
</Window>
