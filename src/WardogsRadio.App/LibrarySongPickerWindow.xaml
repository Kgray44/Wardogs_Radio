<Window x:Class="WardogsRadio.App.LibrarySongPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add From Music Library" Width="680" Height="580" WindowStartupLocation="CenterOwner" Background="#101514" Foreground="#E5E9DF" FontFamily="Segoe UI">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="MUSIC LIBRARY" Foreground="#9FB672" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="Heading" Text="ADD CUES TO STATION" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Hint" Text="Selected cues remain shared: edit them in the Library to update every station that uses them." Opacity=".68" TextWrapping="Wrap" Margin="0,5,0,18"/></StackPanel>
    <ListBox x:Name="SongList" Grid.Row="1" SelectionMode="Extended"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#34413C" BorderThickness="0,0,0,1" Padding="4,10"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Opacity=".65" FontSize="11"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="CANCEL" IsCancel="True"/><Button Content="ADD SELECTED" Click="Add_Click" Background="#33452E"/></StackPanel>
  </Grid>
</Window>
