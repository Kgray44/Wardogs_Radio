<Window x:Class="WardogsRadio.App.BackupTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup &amp; Transfer" Width="620" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource OliveBrush}" BorderThickness="1" CornerRadius="7" Padding="24">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <TextBlock Text="WARDOGS RADIO" Foreground="{StaticResource OliveBrush}" FontSize="10" FontWeight="Bold"/>
        <TextBlock x:Name="Heading" Text="EXPORT CONFIGURATION" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0"/>
        <TextBlock x:Name="Description" TextWrapping="Wrap" Opacity=".72" Margin="0,7,0,0"/>
      </StackPanel>
      <Border Grid.Row="1" x:Name="PackageSummary" Background="#111817" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,16,0,10" Visibility="Collapsed">
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
      </Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
        <StackPanel x:Name="ExportDetails">
          <TextBlock Text="PACKAGE NAME" Foreground="{StaticResource OliveBrush}" FontSize="10" FontWeight="Bold"/>
          <TextBox x:Name="PackageName" MinHeight="34" Margin="0,4,0,8"/>
          <TextBlock Text="DESCRIPTION (OPTIONAL)" Foreground="{StaticResource OliveBrush}" FontSize="10" FontWeight="Bold"/>
          <TextBox x:Name="PackageDescription" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <CheckBox x:Name="FullBackup" Content="Create a complete restorable backup" Margin="0,2,0,12"/>
        </StackPanel>
        <TextBlock Text="CHOOSE WHAT TO INCLUDE" Foreground="{StaticResource OliveBrush}" FontSize="11" FontWeight="Bold" Margin="0,5,0,6"/>
        <CheckBox x:Name="Stations" Content="Stations and their required Library songs and Media Sources" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="Library" Content="Music Library" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="Macros" Content="Macros" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="Keyboard" Content="Keyboard Bindings" IsChecked="True" Margin="20,4"/>
        <CheckBox x:Name="Controller" Content="HOTAS / Controller Bindings" IsChecked="True" Margin="20,4"/>
        <CheckBox x:Name="Playback" Content="Playback Settings" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="Audio" Content="Audio &amp; Routing Settings" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="General" Content="General settings and provider paths" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="ListeningHistory" Content="Private Listening History and metrics" IsChecked="True" Margin="0,4"/>
        <Expander Header="SELECT SPECIFIC ITEMS" IsExpanded="False" Margin="0,14,0,0">
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="STATIONS" Foreground="{StaticResource OliveBrush}" FontSize="10"/><ListBox x:Name="StationItems" SelectionMode="Multiple" Height="110"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="LIBRARY SONGS" Foreground="{StaticResource OliveBrush}" FontSize="10"/><ListBox x:Name="SongItems" SelectionMode="Multiple" Height="110"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="MACROS" Foreground="{StaticResource OliveBrush}" FontSize="10"/><ListBox x:Name="MacroItems" SelectionMode="Multiple" Height="110"/></StackPanel>
          </Grid>
        </Expander>
        <CheckBox x:Name="LocalMedia" Content="Include local media files" Margin="0,16,0,4"/>
        <TextBlock x:Name="LocalMediaHint" Text="Local media is optional. When it is not included, the package keeps the source reference and the receiving computer will need access to that file." Opacity=".65" TextWrapping="Wrap"/>
        <StackPanel x:Name="ConflictOptions" Visibility="Collapsed" Margin="0,16,0,0">
          <TextBlock Text="IF A CONFLICT IS FOUND" Foreground="{StaticResource OliveBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
          <TextBlock Text="Library items" Opacity=".7"/><ComboBox x:Name="LibraryConflict" SelectedIndex="0" MinHeight="32"><ComboBoxItem Content="Import as safe copy (recommended)"/><ComboBoxItem Content="Keep current item"/><ComboBoxItem Content="Replace current item"/></ComboBox>
          <TextBlock Text="Stations" Opacity=".7" Margin="0,10,0,0"/><ComboBox x:Name="StationConflict" SelectedIndex="0" MinHeight="32"><ComboBoxItem Content="Keep both (recommended)"/><ComboBoxItem Content="Keep current station"/><ComboBoxItem Content="Replace current station"/><ComboBoxItem Content="Skip imported station"/></ComboBox>
        </StackPanel>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="CANCEL" IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="ContinueButton" Content="CONTINUE" IsDefault="True" Click="Continue_Click" Background="#33452E"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
