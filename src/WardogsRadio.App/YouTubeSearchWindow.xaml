<Window x:Class="WardogsRadio.App.YouTubeSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Search YouTube" Width="900" Height="720" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#101514" Foreground="#E5E9DF"
        FontFamily="Segoe UI" Closing="Window_Closing">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="MUSIC DISCOVERY" Foreground="#9FB672" FontWeight="Bold" FontSize="11"/>
      <TextBlock Text="SEARCH YOUTUBE" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"/>
      <TextBlock Text="Find a video or playlist to add to your Library or station." Opacity=".7" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <DockPanel>
        <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="SEARCH" Click="Search_Click" MinWidth="96" Background="#33452E"/>
        <TextBox x:Name="QueryBox" Height="40" Margin="0,0,9,0" Padding="9,3" VerticalContentAlignment="Center"
                 KeyDown="QueryBox_KeyDown" AutomationProperties.Name="YouTube search query"/>
      </DockPanel>
      <DockPanel Margin="0,12,0,8">
        <TextBlock Text="RESULTS" Foreground="#9FB672" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ComboBox x:Name="TypeBox" Width="145" SelectedIndex="0" SelectionChanged="TypeBox_SelectionChanged"
                  AutomationProperties.Name="Search result type">
          <ComboBoxItem Content="VIDEOS"/><ComboBoxItem Content="PLAYLISTS"/>
        </ComboBox>
      </DockPanel>
      <TextBlock x:Name="StatusText" Text="Enter a query and press Enter or Search." TextWrapping="Wrap"
                 Foreground="#E6B65A" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
      <ProgressBar x:Name="SearchProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Grid>
        <ListBox x:Name="ResultsList" SelectionChanged="ResultsList_SelectionChanged"
                 KeyDown="ResultsList_KeyDown" MouseDoubleClick="ResultsList_MouseDoubleClick"
                 AutomationProperties.Name="YouTube search results">
          <ListBox.ItemTemplate><DataTemplate>
            <Border BorderBrush="#35413C" BorderThickness="0,0,0,1" Padding="5,11">
              <DockPanel>
                <Grid Width="112" Height="66" Margin="0,0,12,0">
                  <Border Background="#29352F" CornerRadius="3"><TextBlock Text="♪" FontSize="23" Opacity=".5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340"/>
                  <TextBlock Text="{Binding Creator}" Opacity=".72" TextTrimming="CharacterEllipsis" MaxWidth="340" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Detail}" Foreground="#9FB672" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="ResultsEmptyText" Text="Search results will appear here." Opacity=".6" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="300" IsHitTestVisible="False"/>
      </Grid>
      <Border Grid.Column="1" Margin="14,0,0,0" Background="#202A27" BorderBrush="#35413C" BorderThickness="1" Padding="14">
        <StackPanel>
          <TextBlock Text="PREVIEW" Foreground="#9FB672" FontWeight="Bold"/>
          <TextBlock x:Name="PreviewHint" Text="Select a video, then choose Preview." Opacity=".7" TextWrapping="Wrap" Margin="0,7,0,13"/>
          <Button x:Name="PreviewButton" Content="PREVIEW SELECTED" Click="Preview_Click" IsEnabled="False"/>
          <Button x:Name="StopPreviewButton" Content="STOP PREVIEW" Click="StopPreview_Click" IsEnabled="False" Margin="0,7,0,0"/>
          <wv2:WebView2 x:Name="PreviewView" Height="190" Margin="0,13,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="CANCEL" IsCancel="True"/>
        <Button x:Name="SelectButton" Content="SELECT" Click="Select_Click" IsEnabled="False" Background="#33452E" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock x:Name="SelectedText" Text="No selection" Opacity=".65" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>
