<Window x:Class="WardogsRadio.App.YouTubeSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Search YouTube" Width="850" Height="720" MinWidth="680" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#101514" Foreground="#E5E9DF" FontFamily="Segoe UI" Closing="Window_Closing">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="MUSIC DISCOVERY" Foreground="#9FB672" FontWeight="Bold" FontSize="11"/><TextBlock Text="SEARCH YOUTUBE" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Search for a video or playlist, then add it through the normal Library source path." Opacity=".7" Margin="0,4,0,14"/></StackPanel>
    <StackPanel Grid.Row="1"><DockPanel><Button DockPanel.Dock="Right" Content="SEARCH" Click="Search_Click" MinWidth="94" Background="#33452E"/><TextBox x:Name="QueryBox" Height="38" Margin="0,0,8,0" Padding="8,2" VerticalContentAlignment="Center" KeyDown="QueryBox_KeyDown" AutomationProperties.Name="YouTube search query"/></DockPanel><DockPanel Margin="0,10,0,8"><TextBlock DockPanel.Dock="Left" Text="RESULTS" Foreground="#9FB672" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="TypeBox" Width="145" SelectedIndex="0" SelectionChanged="TypeBox_SelectionChanged" AutomationProperties.Name="Search result type"><ComboBoxItem Content="VIDEOS"/><ComboBoxItem Content="PLAYLISTS"/></ComboBox></DockPanel><TextBlock x:Name="StatusText" Text="Enter a query and press Enter or Search." TextWrapping="Wrap" Foreground="#E6B65A" Margin="0,0,0,8"/><DockPanel x:Name="KeyPanel" Visibility="Collapsed"><TextBlock Text="API KEY FOR THIS SESSION" Foreground="#9FB672" VerticalAlignment="Center" Margin="0,0,10,0"/><Button DockPanel.Dock="Right" Content="USE KEY" Click="UseKey_Click"/><PasswordBox x:Name="KeyBox" Width="300" Margin="0,0,8,0" AutomationProperties.Name="YouTube Data API key"/></DockPanel><Button x:Name="ChangeKeyButton" Content="CHANGE SEARCH KEY" Click="ChangeKey_Click" Visibility="Collapsed" HorizontalAlignment="Left"/></StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><ListBox x:Name="ResultsList" SelectionChanged="ResultsList_SelectionChanged" AutomationProperties.Name="YouTube search results"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#35413C" BorderThickness="0,0,0,1" Padding="4,10"><DockPanel><Image Source="{Binding ThumbnailUrl}" Width="110" Height="65" Stretch="UniformToFill" Margin="0,0,12,0"/><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340"/><TextBlock Text="{Binding Creator}" Opacity=".72" TextTrimming="CharacterEllipsis" MaxWidth="340"/><TextBlock Text="{Binding Detail}" Foreground="#9FB672" FontSize="11"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="1" Margin="12,0,0,0" Background="#202A27" BorderBrush="#35413C" BorderThickness="1" Padding="12"><StackPanel><TextBlock Text="PREVIEW" Foreground="#9FB672" FontWeight="Bold"/><TextBlock x:Name="PreviewHint" Text="Select a video, then choose Preview." Opacity=".7" TextWrapping="Wrap" Margin="0,6,0,12"/><Button x:Name="PreviewButton" Content="PREVIEW SELECTED" Click="Preview_Click" IsEnabled="False"/><Button x:Name="StopPreviewButton" Content="STOP PREVIEW" Click="StopPreview_Click" IsEnabled="False"/><wv2:WebView2 x:Name="PreviewView" Height="190" Margin="0,12,0,0" Visibility="Collapsed"/></StackPanel></Border></Grid>
    <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="SelectedText" Text="No selection" Opacity=".65" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="CANCEL" IsCancel="True"/><Button x:Name="SelectButton" Content="SELECT" Click="Select_Click" IsEnabled="False" Background="#33452E"/></StackPanel></DockPanel>
  </Grid>
</Window>
