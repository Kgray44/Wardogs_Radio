            <Button Content="REFRESH MPV OUTPUT LIST" Click="RefreshMpvOutputs_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          </StackPanel></Expander>
          <WrapPanel Margin="0,15,0,20"><Button Content="RECONNECT VOICEMEETER" Click="Reconnect_Click"/><Button Content="TEST MUSIC" Click="TestMusic_Click"/><Button Content="TEST MICROPHONE" Click="TestMicrophone_Click"/><Button Content="UNDO WIZARD ROUTES" Click="RestoreRoute_Click"/><Button Content="OPEN VOICEMEETER" Click="OpenVm_Click"/></WrapPanel>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="900" HorizontalAlignment="Left">
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="24" CornerRadius="5"><StackPanel>
            <TextBlock Text="PLAYBACK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OliveBrush}"/>
