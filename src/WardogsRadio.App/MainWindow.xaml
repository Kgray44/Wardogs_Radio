            <Button Content="CHECK FOR UPDATES" Click="CheckForUpdates_Click" HorizontalAlignment="Left"/>
          </StackPanel></Border>
          <TextBlock Text="Playback and level changes apply and save automatically." Opacity=".6" Margin="0,16,0,20"/>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="DiagnosticsView" Visibility="Collapsed"><StackPanel><WrapPanel><Button Content="RUN CHECKS" Click="RunDiagnostics_Click"/><Button Content="SCAN EXTERNAL AUDIO" Click="ScanExternalDiagnostics_Click"/><Button Content="EXPORT DIAGNOSTIC REPORT" Click="ExportDiagnostics_Click"/></WrapPanel><ItemsControl x:Name="DiagnosticList" Margin="0,12"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Area}" Foreground="{StaticResource OliveBrush}"/><TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="Bold"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Summary}"/><Expander Header="TECHNICAL DETAILS" Margin="0,6,0,0"><TextBlock Text="{Binding Detail}" Opacity=".6" TextWrapping="Wrap"/></Expander></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="SetupView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="840" HorizontalAlignment="Left">
          <TextBlock Text="SYSTEM → DEVICES → ROUTES → TEST → STATIONS → CONTROLS" FontSize="11" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" Margin="0,4,0,7"/>
