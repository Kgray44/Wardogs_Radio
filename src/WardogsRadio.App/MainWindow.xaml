            <Expander Header="ADVANCED · NATIVE PLAYBACK" Margin="0,24,0,0"><StackPanel><TextBlock Text="MPV is found automatically. Choose an executable only if it was not found. The path saves when you finish editing it." TextWrapping="Wrap" Opacity=".7" Margin="0,0,0,8"/><TextBox x:Name="MpvPathBox" LostFocus="MpvPathBox_LostFocus" MinHeight="38"/></StackPanel></Expander>
          </StackPanel></Border>
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="24" CornerRadius="5" Margin="0,12,0,0"><StackPanel>
            <TextBlock Text="MUSIC SERVICES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OliveBrush}" Margin="0,0,0,12"/>
            <WrapPanel><Border Style="{StaticResource ProviderCard}"><StackPanel><TextBlock Text="LOCAL MUSIC" FontWeight="Bold"/><TextBlock Text="Files and radio streams" Opacity=".65"/><TextBlock x:Name="MpvProviderState" Text="CHECKING" Foreground="{StaticResource OliveBrush}" Margin="0,7,0,0"/><Button Content="CHOOSE OUTPUT" Click="Audio_Click"/></StackPanel></Border>
              <Border Style="{StaticResource ProviderCard}"><StackPanel><TextBlock Text="YOUTUBE" FontWeight="Bold"/><TextBlock Text="Visible video player" Opacity=".65"/><TextBlock x:Name="YouTubeProviderState" Text="CHECKING" Foreground="{StaticResource OliveBrush}" Margin="0,7,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource ProviderCard}"><StackPanel><TextBlock Text="EXTERNAL APPS" FontWeight="Bold"/><TextBlock Text="Control a music app" Opacity=".65"/><Button Content="VIEW MUSIC APPS" Click="Stations_Click" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource ProviderCard}"><StackPanel><TextBlock Text="SOUNDCLOUD" FontWeight="Bold"/><TextBlock Text="Account not connected" Opacity=".65"/><Button Content="WHY UNAVAILABLE" Click="OpenSoundCloudSetup_Click" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource ProviderCard}"><StackPanel><TextBlock Text="APPLE MUSIC" FontWeight="Bold"/><TextBlock Text="Account not connected" Opacity=".65"/><Button Content="WHY UNAVAILABLE" Click="OpenAppleSetup_Click" Margin="0,12,0,0"/></StackPanel></Border>
            </WrapPanel>
          </StackPanel></Border>
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="24" CornerRadius="5" Margin="0,12,0,0"><StackPanel>
