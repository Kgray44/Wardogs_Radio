          <TextBlock x:Name="SetupStepTitle" Text="STEP 1 OF 10 · SYSTEM CHECK" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
          <ProgressBar x:Name="SetupProgress" Minimum="0" Maximum="10" Value="1" Height="7" Margin="0,0,0,16"/>
          <Border x:Name="SetupStepSystem" Background="{StaticResource PanelBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,10"><StackPanel>
            <TextBlock Text="1 · SYSTEM CHECK" Foreground="{StaticResource OliveBrush}" FontWeight="Bold"/>
            <TextBlock Text="WARDOGS checks the essentials before making audio changes." TextWrapping="Wrap" Opacity=".7" Margin="0,6,0,12"/>
            <TextBlock x:Name="SetupSystemChecks" Text="Checking…" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,10"/>
            <Button Content="RUN SYSTEM CHECK" Click="SetupSystemCheck_Click" HorizontalAlignment="Left"/>
          </StackPanel></Border>
          <Border x:Name="SetupStepConnect" Background="{StaticResource PanelBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,10"><StackPanel>
            <TextBlock Text="2 · CONNECT VOICEMEETER" Foreground="{StaticResource OliveBrush}" FontWeight="Bold"/>
            <TextBlock x:Name="SetupVmState" Text="Checking engine…" TextWrapping="Wrap" Margin="0,9,0,9"/>
            <WrapPanel><Button Content="CONNECT VOICEMEETER" Click="Reconnect_Click"/><Button Content="OPEN VOICEMEETER" Click="OpenVm_Click"/></WrapPanel>
          </StackPanel></Border>
