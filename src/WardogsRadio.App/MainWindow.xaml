            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="14"><StackPanel>
              <TextBlock Text="STATION MUSIC → VOICEMEETER MUSIC INPUT → GAME VOICE B1" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="1 · SECOND PLAYER OUTPUT" Margin="0,0,0,5"/><ComboBox x:Name="SetupGameMpvOutputBox" ItemTemplate="{StaticResource MpvOutputChoice}" SelectionChanged="SetupGameMpvOutputBox_SelectionChanged" MinHeight="40"/>
