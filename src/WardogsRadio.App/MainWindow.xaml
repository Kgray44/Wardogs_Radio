              <TextBlock Text="Game-music virtual strip"/><ComboBox x:Name="SetupMusicStripBox" DisplayMemberPath="Label" SelectionChanged="SetupMusicStripBox_SelectionChanged" MinHeight="36" Margin="0,4,0,10"/>
              <TextBlock x:Name="SetupStripState" Text="Choose strips and watch the live meters." TextWrapping="Wrap" Margin="0,4,0,0"/>
              <WrapPanel Margin="0,10,0,0"><Button Content="SEND MIC TO B1" Click="SetupRouteMic_Click"/><Button x:Name="SetupRouteMusicButton" Content="SEND MUSIC TO B1 + A1" Click="SetupRouteMusic_Click"/></WrapPanel>
            </StackPanel></Expander>
            <TextBlock Text="Selected mic's live level" Margin="0,14,0,3"/><ProgressBar x:Name="SetupMicMeter" Height="8"/>
            <TextBlock Text="Voicemeeter game-music input's live level" Margin="0,10,0,3"/><ProgressBar x:Name="SetupMusicMeter" Height="8"/>
          </StackPanel></Border>
          <Border x:Name="SetupStepVerify" Background="{StaticResource PanelBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,10"><StackPanel>
            <TextBlock Text="6 · TEST THE SIGNAL CHAIN" Foreground="{StaticResource OliveBrush}" FontWeight="Bold"/>
            <TextBlock x:Name="SetupVerifyDescription" Text="B1 is the game-voice output. The lower meter shows your chosen listening output." TextWrapping="Wrap" Opacity=".7" Margin="0,6,0,10"/>
            <TextBlock x:Name="SetupBusState" Text="Checking B1 and A1…" TextWrapping="Wrap"/>
            <TextBlock Text="Game voice bus B1" Margin="0,10,0,3"/><ProgressBar x:Name="SetupGameMeter" Height="8"/>
            <TextBlock x:Name="SetupB1EndpointLabel" Text="Voicemeeter Out B1 · Windows output" Margin="0,10,0,3"/><ProgressBar x:Name="SetupB1EndpointMeter" Height="8"/>
            <TextBlock x:Name="SetupListeningMeterLabel" Text="Selected listening output" Margin="0,10,0,3"/><ProgressBar x:Name="SetupMonitorMeter" Height="8"/>
            <WrapPanel Margin="0,12,0,0"><Button Content="TEST MICROPHONE" Click="TestMicrophone_Click"/><Button Content="TEST MUSIC INPUT" Click="TestMusic_Click"/><Button Content="PLAY TEST SOUND" Click="SetupPlayTestSound_Click"/><Button Content="VERIFY B1" Click="SetupVerifyB1_Click"/></WrapPanel>
            <TextBlock x:Name="SetupChainTestState" Text="Run each test while your microphone and a station are active." TextWrapping="Wrap" Margin="0,8,0,0"/>
