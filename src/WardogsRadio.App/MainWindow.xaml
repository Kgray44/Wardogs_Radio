            <TextBlock x:Name="SetupDeviceState" Text="Choose your listening output." TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock Text="LISTENING LEVEL" Margin="0,10,0,4"/><ProgressBar x:Name="SetupMonitorSelectionMeter" Height="9"/>
            <WrapPanel Margin="0,10,0,0"><Button Content="PLAY TEST SOUND" Click="SetupPlayTestSound_Click"/><Button Content="REFRESH OUTPUTS" Click="RefreshAudioEndpoints_Click"/></WrapPanel>
