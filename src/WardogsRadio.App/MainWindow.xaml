            <TextBlock Text="MIC LEVEL" Margin="0,4,0,4"/><ProgressBar x:Name="SetupMicSelectionMeter" Height="9"/>
            <TextBlock Text="MICROPHONE VOLUME · 100% normal; 160% maximum boost" Margin="0,12,0,4" TextWrapping="Wrap"/>
            <Slider x:Name="SetupMicrophoneVolume" Minimum="0" Maximum="1.6" Value="1" ValueChanged="MicrophoneVolume_ValueChanged" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/>
            <TextBlock x:Name="SetupMicrophoneVolumeText" Text="100% · Changes Voicemeeter mic strip immediately" Opacity=".65" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,10,0,0"><Button Content="TEST MICROPHONE" Click="TestMicrophone_Click"/><Button Content="REFRESH MICROPHONES" Click="RefreshAudioEndpoints_Click"/></WrapPanel>
            <TextBlock x:Name="SetupMicTestState" Text="Speak after pressing Test Microphone." TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <Border x:Name="SetupStepMonitor" Background="{StaticResource PanelBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,10"><StackPanel>
