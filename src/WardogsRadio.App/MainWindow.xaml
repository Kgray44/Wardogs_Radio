              <ComboBox x:Name="SetupMpvOutputBox" ItemTemplate="{StaticResource MpvOutputChoice}" SelectionChanged="SetupMpvOutputBox_SelectionChanged" MinHeight="36"/>
              <TextBlock x:Name="SetupMpvOutputState" Text="Current output: Windows default until changed." TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel></Expander>
            <Button Content="REFRESH PLAYER OUTPUTS" Click="RefreshMpvOutputs_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          </StackPanel></Border>
          <Border x:Name="SetupStepRouting" Background="{StaticResource PanelBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,10"><StackPanel>
