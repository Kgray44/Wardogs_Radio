            <TextBlock Text="Music-strip meter source · selection updates live meter immediately; B1 route state is shown below" Margin="0,14,0,5" TextWrapping="Wrap"/><ComboBox x:Name="MusicStripBox" DisplayMemberPath="Label" SelectionChanged="MusicStripBox_SelectionChanged" MinHeight="40"/>
