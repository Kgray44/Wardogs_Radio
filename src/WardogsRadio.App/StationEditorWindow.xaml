<Window x:Class="WardogsRadio.App.StationEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Station Editor" Width="740" Height="740" WindowStartupLocation="CenterOwner" Background="#101514" Foreground="#E5E9DF" FontFamily="Segoe UI">
 <Window.Resources><Style x:Key="SourceSwitchChoice" TargetType="RadioButton"><Setter Property="Foreground" Value="#AEB9AC"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="surface" Background="#18201E" BorderBrush="#34413C" BorderThickness="1" CornerRadius="4" Padding="16,11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="surface" Property="Background" Value="#33452E"/><Setter TargetName="surface" Property="BorderBrush" Value="#9FB672"/><Setter Property="Foreground" Value="#E5F2CC"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#E6B65A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="STATION" Foreground="#9FB672" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="Heading" Text="CREATE RADIO STATION" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Choose a name, identity, source, then validate before saving." Opacity=".65" Margin="0,4,0,18"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="IDENTITY" Foreground="#9FB672" FontSize="11" FontWeight="Bold"/><TextBlock Text="Name" Margin="0,12,0,4"/><TextBox x:Name="NameBox" Height="42" Padding="8,3" VerticalContentAlignment="Center"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Icon" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal"><Viewbox Width="28" Height="28" Margin="0,0,8,0"><Path x:Name="IconPreview" Fill="#9FB672" Width="24" Height="24" Stretch="Uniform"/></Viewbox><Button x:Name="ChooseIconButton" Content="CHOOSE ICON" Click="ChooseIcon_Click"/></StackPanel><TextBlock x:Name="IconName" Text="Patrol" Opacity=".65" FontSize="11"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Accent color" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal"><Border x:Name="AccentSwatch" Width="34" Height="34" CornerRadius="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,7,0"/><Button Content="CHOOSE COLOR" Click="ChooseColor_Click"/></StackPanel><TextBlock x:Name="AccentLabel" Text="#9FB672" Opacity=".65" FontSize="11"/></StackPanel></Grid>
   <TextBlock Text="AUDIO SOURCE" Foreground="#9FB672" FontSize="11" FontWeight="Bold" Margin="0,24,0,0"/><TextBlock Text="Where does this station get its music?" Margin="0,12,0,8"/>
   <WrapPanel>
     <Button x:Name="LocalProviderTile" Tag="mpv-local" Click="ProviderTile_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="LOCAL MUSIC" FontWeight="Bold"/><TextBlock Text="Files and playlists" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
     <Button x:Name="RadioProviderTile" Tag="mpv-link" Click="ProviderTile_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="INTERNET RADIO" FontWeight="Bold"/><TextBlock Text="Direct stream link" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
     <Button x:Name="YouTubeProviderTile" Tag="youtube" Click="ProviderTile_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="YOUTUBE" FontWeight="Bold"/><TextBlock Text="Visible video player" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
     <Button x:Name="ExternalProviderTile" Tag="external-audio" Click="ProviderTile_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="MUSIC APP" FontWeight="Bold"/><TextBlock Text="Windows media session" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
     <Button x:Name="SoundCloudProviderTile" Tag="soundcloud" Click="ProviderTile_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="SOUNDCLOUD" FontWeight="Bold"/><TextBlock Text="Account access needed" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
     <Button x:Name="AppleProviderTile" Tag="applemusic" Click="ProviderTile_Click" Width="202" MinHeight="78"><StackPanel><TextBlock Text="APPLE MUSIC" FontWeight="Bold"/><TextBlock Text="Account access needed" Opacity=".7" TextWrapping="Wrap"/></StackPanel></Button>
   </WrapPanel>
   <ComboBox x:Name="ProviderBox" Visibility="Collapsed" SelectionChanged="Provider_Changed"><ComboBoxItem Tag="soundcloud" Content="SoundCloud"/><ComboBoxItem Tag="applemusic" Content="Apple Music"/><ComboBoxItem Tag="youtube" Content="YouTube"/><ComboBoxItem Tag="external-audio" Content="Music app"/><ComboBoxItem Tag="mpv-local" Content="Local music"/><ComboBoxItem Tag="mpv-link" Content="Internet radio"/></ComboBox><TextBlock x:Name="ProviderHint" Text="Choose a music source." Opacity=".65" TextWrapping="Wrap" Margin="0,7,0,0"/>
   <TextBlock Text="SOURCE TYPE" Foreground="#9FB672" FontSize="11" FontWeight="Bold" Margin="0,18,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><RadioButton x:Name="LinkSourceChoice" Style="{StaticResource SourceSwitchChoice}" Content="ONLINE LINK" GroupName="SourceType" Checked="SourceChoice_Changed"/><RadioButton x:Name="LocalSourceChoice" Grid.Column="1" Style="{StaticResource SourceSwitchChoice}" Content="LOCAL PLAYLIST" GroupName="SourceType" Checked="SourceChoice_Changed"/></Grid>
   <StackPanel x:Name="LinkSourcePanel" Margin="0,16,0,0"><TextBlock x:Name="LinkSourceLabel" Text="Music link (https://...)" Margin="0,0,0,4"/><TextBox x:Name="SourceBox" Height="42" Padding="8,3" VerticalContentAlignment="Center" TextChanged="SourceBox_TextChanged"/><TextBlock Text="Paste a direct stream, playlist, or provider link. Local file paths are added in Local Playlist instead." Opacity=".65" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
   <StackPanel x:Name="PlaylistPanel" Margin="0,16,0,0" Visibility="Collapsed"><TextBlock Text="LOCAL FILE PLAYLIST" Foreground="#9FB672" FontSize="11" FontWeight="Bold"/><TextBlock Text="Add files one at a time, in a batch, or from a folder. This list is the station's source and plays in the shown order." Opacity=".65" TextWrapping="Wrap" Margin="0,5,0,8"/><ListBox x:Name="PlaylistList" Height="150" SelectionMode="Single" DisplayMemberPath="Name"/><TextBlock x:Name="PlaylistCount" Text="0 tracks" Opacity=".65" Margin="0,5,0,0"/><WrapPanel Margin="0,6,0,0"><Button Content="+ ADD FILES" Click="AddPlaylistFiles_Click"/><Button Content="+ ADD FOLDER" Click="AddPlaylistFolder_Click"/><Button Content="REMOVE SELECTED" Click="RemovePlaylistFiles_Click"/><Button Content="MOVE UP" Click="MovePlaylistUp_Click"/><Button Content="MOVE DOWN" Click="MovePlaylistDown_Click"/><Button Content="CLEAR LIST" Click="ClearPlaylist_Click"/></WrapPanel></StackPanel>
   <StackPanel x:Name="OrderPanel"><TextBlock Text="PLAYBACK ORDER" Foreground="#9FB672" FontSize="11" FontWeight="Bold" Margin="0,16,0,6"/><WrapPanel><Button x:Name="OrderButton" Content="PLAY IN ORDER" Click="PlayInOrder_Click"/><Button x:Name="ShuffleButton" Content="SHUFFLE / RESHUFFLE" Click="ShuffleAgain_Click"/></WrapPanel><TextBlock x:Name="OrderHint" Opacity=".65" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="VALIDATE SOURCE" Click="Validate_Click"/><TextBlock x:Name="ValidationText" VerticalAlignment="Center" Margin="10,0" Foreground="#E6B65A" TextWrapping="Wrap" MaxWidth="370"/></StackPanel><CheckBox x:Name="DraftCheck" Content="Save as an incomplete draft if the source cannot be played yet" Margin="0,12,0,0"/>
   <TextBlock Text="STATION MUSIC LEVELS" Foreground="#9FB672" FontSize="11" FontWeight="Bold" Margin="0,22,0,8"/>
   <TextBlock Text="Headset station level" Margin="0,0,0,4"/><Slider x:Name="StationVolume" Minimum="0" Maximum="1" Value=".72" ValueChanged="StationVolume_Changed"/><TextBlock x:Name="StationVolumeText" Text="72% · Multiplied by headset master level" Opacity=".65" Margin="0,4,0,12"/>
   <TextBlock Text="Game station level" Margin="0,0,0,4"/><Slider x:Name="GameStationVolume" Minimum="0" Maximum="1" Value=".72" ValueChanged="GameStationVolume_Changed"/><TextBlock x:Name="GameStationVolumeText" Text="72% · Multiplied by game master level when connected" Opacity=".65" TextWrapping="Wrap" Margin="0,4,0,12"/>
   <Expander Header="ADVANCED" Margin="0,18,0,0"><StackPanel Margin="10">
     <TextBlock Text="Repeat" Margin="0,0,0,4"/><ComboBox x:Name="RepeatModeBox"><ComboBoxItem Tag="Off" Content="Off · stop at the end"/><ComboBoxItem Tag="Playlist" Content="Repeat station / playlist"/><ComboBoxItem Tag="Track" Content="Repeat current song"/></ComboBox><TextBlock Text="You can also cycle repeat beside the Dashboard play controls." Opacity=".65" TextWrapping="Wrap" Margin="0,6,0,10"/><TextBlock Text="Playback behavior" Margin="0,12,0,4"/><ComboBox x:Name="ModeBox"><ComboBoxItem Tag="default" Content="Use global setting"/><ComboBoxItem Tag="player" Content="Player mode when supported"/><ComboBoxItem Tag="radio" Content="Radio mode when supported"/><ComboBoxItem Tag="restarttrack" Content="Restart last song from 00:00 when returning"/></ComboBox></StackPanel></Expander></StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="CANCEL" IsCancel="True"/><Button Content="SAVE STATION" Click="Save_Click" Background="#33452E"/></StackPanel>
 </Grid>
</Window>
