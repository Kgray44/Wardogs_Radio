<Window x:Class="WardogsRadio.App.LibrarySourceInspectorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Source Archive" Width="940" Height="720" WindowStartupLocation="CenterOwner" Background="#101514" Foreground="#E5E9DF" FontFamily="Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SOURCE / ARCHIVE" Foreground="#9FB672" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="SourceNameText" Text="SOURCE" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SourceIdentityText" Text="" Opacity=".62" TextTrimming="CharacterEllipsis" MaxWidth="700"/><TextBlock x:Name="SourceListeningText" Text="No listening history yet." Foreground="#9FB672" FontSize="11" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#253128" CornerRadius="11" Padding="10,4" VerticalAlignment="Center"><TextBlock x:Name="SourceStateText" Text="PREPARING" Foreground="#D5E8B4" FontWeight="Bold" FontSize="11"/></Border></Grid>
    <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="260"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#121A18" BorderBrush="#34413C" BorderThickness="1" CornerRadius="5"><Grid><wv2:WebView2 x:Name="YouTubePreview" Visibility="Collapsed"/><StackPanel x:Name="LocalPreview" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="LOCAL SOURCE PREVIEW" Foreground="#9FB672" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="LocalPreviewText" Text="Preparing isolated mpv preview…" Opacity=".65" Margin="0,8,0,0"/></StackPanel></Grid></Border>
      <StackPanel Grid.Row="1" Margin="0,14,0,14"><DockPanel><TextBlock x:Name="PreviewTimeText" Text="00:00 / --:--" Opacity=".72"/><WrapPanel DockPanel.Dock="Right"><Button x:Name="PreviewPlayButton" Content="▶ PREVIEW" Click="PreviewPlay_Click"/><Button x:Name="PreviewPauseButton" Content="PAUSE" Click="PreviewPause_Click"/><Button x:Name="CreateSongButton" Content="CREATE SONG AT CURSOR" Click="CreateSong_Click"/></WrapPanel></DockPanel><Grid x:Name="TimelineSurface" Height="28" Cursor="Hand" MouseLeftButtonDown="Timeline_MouseLeftButtonDown" MouseRightButtonUp="Timeline_MouseRightButtonUp"><ProgressBar x:Name="TimelineProgress" Height="8" VerticalAlignment="Center" Maximum="100"/><Grid.ContextMenu><ContextMenu><MenuItem x:Name="CreateSongMenuItem" Header="Create New Song…" Click="CreateSong_Click"/></ContextMenu></Grid.ContextMenu></Grid><TextBlock x:Name="TimelineHintText" Text="Preview source time · right-click a point to split the containing cue." Opacity=".6" FontSize="11" Margin="0,4,0,0"/></StackPanel>
      <Border Grid.Row="2" Background="#121A18" BorderBrush="#34413C" BorderThickness="1" CornerRadius="5" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="SONGS FROM THIS SOURCE" Foreground="#9FB672" FontWeight="Bold"/><TextBlock x:Name="SongsSummaryText" Text="" Opacity=".62" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="REFRESH" Click="Refresh_Click"/></DockPanel><ListBox x:Name="SongList" Grid.Row="1" Margin="0,10,0,0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="3,6"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timing}" Foreground="#9FB672"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Opacity=".6" FontSize="11"/></StackPanel><Button Grid.Column="2" Content="PREVIEW CUE" Tag="{Binding Song}" Click="PreviewSong_Click" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="CLOSE" IsCancel="True"/></StackPanel>
  </Grid>
</Window>
