<Window x:Class="WardogsRadio.App.AudioDevicePickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Audio Device" Width="620" Height="620" MinWidth="470" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource InkBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="Heading" Text="CHOOSE A DEVICE" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11"/>
      <TextBlock x:Name="Description" Text="Choose an available Windows audio device." FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,8"/>
      <TextBlock Text="Selecting a device applies it immediately. You can change it again at any time." Opacity=".65" TextWrapping="Wrap"/></StackPanel>
    <TextBox x:Name="SearchBox" Grid.Row="1" MinHeight="40" Margin="0,16,0,10" TextChanged="SearchBox_TextChanged" ToolTip="Search devices by name"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="DevicesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Endpoint}" Click="Choose_Click" Width="265" MinHeight="112" Margin="0,0,10,10" Padding="14" Background="{Binding Surface}" BorderBrush="{Binding Outline}" HorizontalContentAlignment="Stretch">
        <StackPanel HorizontalAlignment="Left"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="225"/>
          <TextBlock Text="{Binding Category}" Foreground="{StaticResource OliveBrush}" FontSize="11" Margin="0,7,0,0"/>
          <TextBlock Text="{Binding State}" Foreground="{StaticResource AmberBrush}" FontSize="10" Margin="0,5,0,0"/>
        </StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <DockPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="CountText" Text="No devices found" VerticalAlignment="Center" Opacity=".7"/><Button DockPanel.Dock="Right" Content="CANCEL" Click="Cancel_Click"/></DockPanel>
  </Grid>
</Window>
