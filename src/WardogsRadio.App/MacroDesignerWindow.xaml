<Window x:Class="WardogsRadio.App.MacroDesignerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Macro Editor" Width="1050" Height="820" MinWidth="830" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{StaticResource InkBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="MACROS" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Build radio controls" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="A macro is a named action or sequence you can run from the dashboard or a binding." Opacity=".7" Margin="0,4,0,16"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="YOUR MACROS" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" Margin="8,8,0,10"/>
        <ListBox x:Name="MacroList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="MacroList_SelectionChanged"/>
        <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="+ NEW" Click="Add_Click"/><Button Content="DUPLICATE" Click="Duplicate_Click"/><Button Content="MOVE UP" Click="MoveMacroUp_Click"/><Button Content="MOVE DOWN" Click="MoveMacroDown_Click"/><Button Content="DELETE" Click="Remove_Click"/></WrapPanel>
      </Grid>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
        <TextBlock Text="IDENTITY" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Name" Margin="0,12,0,4"/><TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"/>
        <TextBlock Text="Description (optional)" Margin="0,10,0,4"/><TextBox x:Name="DescriptionBox"/>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Icon" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal"><Viewbox Width="30" Height="30" Margin="0,0,8,0"><Path x:Name="IconPreview" Fill="{StaticResource OliveBrush}" Width="24" Height="24" Stretch="Uniform"/></Viewbox><Button Content="CHOOSE ICON" Click="ChooseIcon_Click"/></StackPanel><TextBlock x:Name="IconName" Opacity=".65" FontSize="11"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Accent color" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal"><Border x:Name="AccentSwatch" Width="32" Height="32" CornerRadius="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0"/><Button Content="CHOOSE COLOR" Click="ChooseColor_Click"/></StackPanel><TextBlock x:Name="AccentLabel" Text="#9FB672" Opacity=".65" FontSize="11"/></StackPanel>
        </Grid>
        <TextBlock Text="ACTIVATION" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11" Margin="0,24,0,8"/>
        <ComboBox x:Name="ActivationBox" SelectionChanged="ActivationBox_SelectionChanged"><ComboBoxItem Tag="Press" Content="Press — run once"/><ComboBoxItem Tag="Hold" Content="Hold — press actions, then release actions"/><ComboBoxItem Tag="Toggle" Content="Toggle — alternate on and off actions"/><ComboBoxItem Tag="Momentary" Content="Momentary — active only while held"/></ComboBox>
        <TextBlock x:Name="ActivationHint" TextWrapping="Wrap" Opacity=".65" Margin="0,6,0,0"/>
        <WrapPanel Margin="0,10,0,0"><CheckBox x:Name="EnabledCheck" Content="Enabled" IsChecked="True"/><CheckBox x:Name="PinCheck" Content="Show on Dashboard" IsChecked="True" Margin="18,0,0,0"/></WrapPanel>
        <TextBlock Text="ACTIONS" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11" Margin="0,24,0,8"/><ComboBox x:Name="PhaseBox" SelectionChanged="PhaseBox_SelectionChanged" DisplayMemberPath="Label"/>
        <ListBox x:Name="ActionsList" Height="175" Margin="0,8,0,4" AllowDrop="True" PreviewMouseLeftButtonDown="ActionsList_PreviewMouseLeftButtonDown" PreviewMouseMove="ActionsList_PreviewMouseMove" DragOver="ActionsList_DragOver" Drop="ActionsList_Drop" SelectionChanged="ActionsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Padding="7" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><DockPanel><TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Foreground="{StaticResource OliveBrush}" Width="28"/><TextBlock DockPanel.Dock="Right" Text="DRAG" Foreground="{StaticResource OliveBrush}" FontSize="9" Opacity=".65"/><StackPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Issue}" Foreground="{StaticResource AmberBrush}" FontSize="10" TextWrapping="Wrap"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        <WrapPanel><Button Content="+ ADD ACTION" Click="AddAction_Click"/><Button Content="MOVE UP" Click="MoveActionUp_Click"/><Button Content="MOVE DOWN" Click="MoveActionDown_Click"/><Button Content="DUPLICATE" Click="DuplicateAction_Click"/><Button Content="REMOVE" Click="RemoveAction_Click"/></WrapPanel>
        <Border x:Name="ActionConfig" Background="{StaticResource Panel2Brush}" Padding="14" Margin="0,10,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="ACTION SETTINGS" Foreground="{StaticResource OliveBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Action" Margin="0,8,0,4"/><ComboBox x:Name="ActionTypeBox" DisplayMemberPath="Name" SelectionChanged="ActionTypeBox_SelectionChanged"/>
          <StackPanel x:Name="StationFields"><TextBlock Text="Station" Margin="0,9,0,4"/><ComboBox x:Name="StationBox" DisplayMemberPath="Name"/></StackPanel>
          <StackPanel x:Name="ValueFields"><TextBlock x:Name="ValueLabel" Text="Value" Margin="0,9,0,4"/><TextBox x:Name="ValueBox"/></StackPanel>
          <StackPanel x:Name="CurveFields"><TextBlock Text="Curve" Margin="0,9,0,4"/><ComboBox x:Name="CurveBox"><ComboBoxItem Tag="EqualPower" Content="Equal Power"/><ComboBoxItem Tag="Linear" Content="Linear"/><ComboBoxItem Tag="Smoothstep" Content="Smoothstep"/></ComboBox></StackPanel>
          <StackPanel x:Name="ArgumentFields"><TextBlock x:Name="ArgumentLabel" Text="Target" Margin="0,9,0,4"/><TextBox x:Name="ArgumentBox"/></StackPanel>
          <TextBlock x:Name="ActionHelp" TextWrapping="Wrap" Opacity=".65" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <TextBlock Text="KEYBOARD BINDINGS" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11" Margin="0,24,0,8"/><ListBox x:Name="KeyboardList" MaxHeight="94"/><WrapPanel><Button Content="+ PRESS A KEY" Click="AddKey_Click"/><Button Content="REMOVE SELECTED" Click="RemoveKey_Click"/></WrapPanel>
        <TextBlock Text="CONTROLLER BINDINGS" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11" Margin="0,20,0,8"/><ListBox x:Name="ControllerList" MaxHeight="94"/><WrapPanel><Button Content="+ BIND CONTROLLER" Click="AddController_Click"/><Button Content="REMOVE SELECTED" Click="RemoveController_Click"/></WrapPanel>
        <TextBlock Text="ADVANCED" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11" Margin="0,22,0,8"/><ComboBox x:Name="FailureBox"><ComboBoxItem Tag="StopOnFailure" Content="Stop on failure (recommended)"/><ComboBoxItem Tag="Continue" Content="Continue after failure"/></ComboBox>
        <TextBlock Text="A failure is always reported; Continue only runs later actions as well." Opacity=".65" TextWrapping="Wrap" Margin="0,5,0,0"/>
        <Border Background="#111817" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,22,0,0"><StackPanel><TextBlock Text="TEST RUN" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="TestResult" Text="Run this macro against the current system before saving." TextWrapping="Wrap" Margin="0,8,0,8"/><Button Content="TEST MACRO" Click="TestMacro_Click" HorizontalAlignment="Left"/></StackPanel></Border>
        <TextBlock x:Name="Hint" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="CANCEL" IsCancel="True"/><Button Content="SAVE MACROS" Background="#33452E" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
