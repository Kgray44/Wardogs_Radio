<Window x:Class="WardogsRadio.App.ControllerCaptureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Controller Binding" Width="450" Height="220" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource InkBrush}" Foreground="{StaticResource TextBrush}">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="CONTROLLER BINDING" Foreground="{StaticResource OliveBrush}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Press a controller button…" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel>
    <TextBlock Grid.Row="1" Text="A connected joystick, HOTAS, gamepad button, or POV direction will be captured. This closes automatically after 15 seconds." Opacity=".7" TextWrapping="Wrap" VerticalAlignment="Center"/>
    <Button Grid.Row="2" Content="CANCEL" HorizontalAlignment="Right" Click="Cancel_Click"/>
  </Grid>
</Window>
